# Puerto HTTP. En Railway lo inyecta la plataforma: no hace falta setearlo.
PORT=3000

# Almacenamiento de produccion. Si esta presente, la app usa PostgreSQL.
# En Railway es una variable de referencia a ${{Postgres.DATABASE_URL}}, asi que
# resuelve a la red privada del proyecto y no hay credenciales en el repo.
DATABASE_URL=postgresql://usuario:password@host:5432/corta

# Solo se usa cuando DATABASE_URL NO esta definida (backend de archivo JSON).
# Local: si se omite, se usa corta/links.json.
# Railway: apunta al volumen persistente montado en /data.
DB_FILE=/data/links.json

NODE_ENV=development
