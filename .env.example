# Puerto HTTP. En Railway lo inyecta la plataforma: no hace falta setearlo.
PORT=3000

# Ruta del archivo JSON donde se guardan los links.
# Local: si se omite, se usa corta/links.json.
# Railway: apunta al volumen persistente montado en /data, porque el
# filesystem del contenedor se descarta en cada redeploy.
DB_FILE=/data/links.json

# Reservado para la migracion a PostgreSQL descrita en el README.
DATABASE_URL=postgresql://usuario:password@host:5432/corta

NODE_ENV=development
